INSTALL_METHOD=remote
REMOTE_INSTALL_HOST=debug-plugin.dify.dev
REMOTE_INSTALL_PORT=5003
REMOTE_INSTALL_KEY=********-****-****-****-************

# Optional Azure OpenAI read-inactivity timeout in seconds (default: 300).
# Must be positive and finite; decimals are supported. Empty/invalid values fail.
# Applies to all shared clients, including credential validation. Restart after changes.
# Direct plugin: set in its process environment. Daemon: forwarding support is required.
# A host .env alone may only supply Compose interpolation; see README deployment example.
# Outer execution/workflow/proxy limits are independent.
# AZURE_OPENAI_READ_TIMEOUT=600
